# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model id (defaults to claude-sonnet-4-6 if unset)
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: data directory (defaults to .data/ in the project root)
# DATA_DIR=/absolute/path/to/data

# Optional: folder watched for auto-ingest into a notebook (set in Memory panel)
# WATCH_DIR=/absolute/path/to/inbox
